{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thingpulse.com/schemas/esp-app-market-manifest-v1.json",
  "title": "ESP App Market release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "app", "release"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "supportedDevices", "tags", "icon"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "instructions": { "type": "string" },
        "repository": { "type": "string", "format": "uri" },
        "supportedDevices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "icon": { "$ref": "#/$defs/assetReference" }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "partitions"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" },
        "partitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "asset", "offset", "sha256"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "asset": { "type": "string", "pattern": "^[^/\\\\]+$" },
              "offset": {
                "oneOf": [
                  { "type": "integer", "minimum": 0 },
                  { "type": "string", "pattern": "^0x[0-9a-fA-F]+$" }
                ]
              },
              "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "assetReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset"],
      "properties": {
        "asset": { "type": "string", "pattern": "^[^/\\\\]+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      }
    }
  }
}
