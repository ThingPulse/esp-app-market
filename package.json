{
  "name": "esp-app-market",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "node updateEnvironmentInfo.js && ng build",
    "build:snapshots": "node updateEnvironmentInfo.js && npm run catalog:sync:snapshots && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "catalog:sync": "node scripts/sync-catalog.js",
    "catalog:sync:snapshots": "node scripts/sync-catalog.js --include-snapshots",
    "catalog:check": "node scripts/sync-catalog.js --check",
    "catalog:test": "node --test scripts/sync-catalog.test.js",
    "repository:init": "node scripts/prepare-repository.js",
    "repository:test": "node --test scripts/prepare-repository.test.js",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots=all"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^15.0.0",
    "@angular/cdk": "^15.1.2",
    "@angular/common": "^15.0.0",
    "@angular/compiler": "^15.0.0",
    "@angular/core": "^15.0.0",
    "@angular/forms": "^15.0.0",
    "@angular/material": "^15.1.2",
    "@angular/platform-browser": "^15.0.0",
    "@angular/platform-browser-dynamic": "^15.0.0",
    "@angular/router": "^15.0.0",
    "@fontsource/inter": "^5.2.8",
    "@types/crypto-js": "^4.2.2",
    "crypto-js": "^4.2.0",
    "esptool-js": "^0.3.2",
    "material-icons": "^1.13.14",
    "rxjs": "~7.5.0",
    "tailwindcss": "^3.2.4",
    "tslib": "^2.3.0",
    "zone.js": "~0.12.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^15.0.5",
    "@angular/cli": "~15.0.5",
    "@angular/compiler-cli": "^15.0.0",
    "@playwright/test": "^1.61.1",
    "@types/jasmine": "~4.3.0",
    "@types/w3c-web-serial": "^1.0.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jasmine-core": "~4.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "typescript": "~4.8.2"
  }
}
